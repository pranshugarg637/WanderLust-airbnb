<% layout("/layouts/boilerplate")%>
<div class="container mt-3">
<div class="row">
    <div class="col-8">
    <h3 class="head ">Create a New Listing</h3>
    <form method="post" action="/listings" class="needs-validation" novalidate enctype="multipart/form-data">
        <div>
            <label for="title" class="form-label">Title</label>
            <input type="text" name="listing[title]" placeholder="Enter Title" class="form-control" required>
            <div class="valid-feedback">Title looks good!</div>
            <div class="invalid-feedback">Enter Title</div>
        </div>
        <br><br>
        <div>
            <label for="description" class="form-label">Description</label>
            <textarea name="listing[description]" rows="10" column="7" class="form-control" required>Enter description here</textarea>
            <div class="invalid-feedback">Enter description</div><br>
        </div>
        <div>
            <label for="image" class="form-label">Upload Image </label>
            <input type="file" name="listing[image]" class="form-control" placeholder="Enter image url/link" required>
            <div class="invalid-feedback">Enter URL</div>
            <div class="valid-feedback">URL entered!</div><br><br>
        </div>
        <div class="row">
            <div class="col-md-5">
                <label for="price" class="form-label">Price</label>
                <input type="number" class="form-control" name="listing[price]" placeholder="Enter Price" required>
                <div class="invalid-feedback">Please enter a valid price!</div><br><br>
            </div>
            <div class="col-md-7">
                <label for="country" class="form-label">Country</label>
                <input class="form-control" type="text" name="listing[country]" placeholder="Enter Country" required>
                <div class="invalid-feedback">Please enter the country name</div><br><br>
            </div>
        </div>
        <div>
            <label for="location" class="form-label">Location</label>
            <input class="form-control" type="text" name="listing[location]" placeholder="Enter Location" required>
            <div class="invalid-feedback">Please enter the location</div><br><br>
        </div>
        <button class="btn btn-dark mb-3 add-btn" type="submit">Add</button>
    </form>
    </div>
</div>
</div>
