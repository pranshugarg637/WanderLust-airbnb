<% layout("/layouts/boilerplate")%>
<div class="container mt-3">
    <div class="row">
        <div class="col-8">
            <h3>Edit this Listing</h3>
            <form method="post" action="/listings/<%=listing._id%>?_method=PUT" novalidate class="needs-validation" enctype="multipart/form-data">
                <div>
                    <label for="title" class="form-label">Title</label>
                    <input type="text" class="form-control" name="listing[title]" value="<%=listing.title%>" required><br><br>
                </div>
                <div>
                    <label for="description" class="form-label">Description</label>
                    <textarea name="listing[description]" class="form-control" rows="10" column="7"><%=listing.description%></textarea><br><br>
                </div><br>
                <div>
                    <h3>Image:-</h3>
                    <img src="<%=originalImageUrl%>" alt="Listing image">
                </div><br>
                <div>
                    <label for="image" class="form-label">Edit Image</label>
                    <input name="listing[image]" class="form-control" type="file"><br><br>
                </div>
                <div class="row">
                    <div class="col-md-5">
                        <label for="price" class="form-label">Price</label>
                        <input name="listing[price]" type="number" class="form-control" value="<%=listing.price%>"required ><br><br>
                    </div>
                    <div class="col-md-7">
                        <label for="country" class="form-label">Country</label>
                        <input name="listing[country]" class="form-control" type="text" value="<%=listing.country%>" ><br><br>
                    </div>
                </div>
                <div>
                    <label for="location" class="form-label">Location</label>
                    <input class="form-control" name="listing[location]" type="text" value="<%=listing.location%>"required><br><br>
                </div>
                <button class="btn btn-dark mb-3 add-btn">Edit</button>
            </form>
        </div>
    </div>
</div>