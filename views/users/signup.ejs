<% layout("/layouts/boilerplate")%>
<div class="row mt-3">
    <h3>SignUp on WanderLust</h3><br><br>
    <div class="col-6">
        <form action="/signup" method="post" class="needs-validation" novalidate>
            <div>
                <label for="username" class="form-label">Username</label>
                <input id="username" type="text" name="username" class="form-control" required>
                <div class="valid-feedback">Username looks good!</div>
                <div class="invalid-feedback">Enter Username</div>
            </div>
            <br>
            <div>
                <label for="email" class="form-label">Email</label>
                <input id="email" type="email" name="email" class="form-control" required>
                <div class="invalid-feedback">Pls enter valid email-id</div>
            </div><br>
            <div>
                <label for="password" class="form-label">Password</label>
                <input id="password" type="password" name="password" class="form-control" required>
                <div class="invalid-feedback">Pls enter a strong and valid password</div>
            </div><br><br>
            <button class="btn btn-success">SignUp</button>
        </form>
    </div>
</div>